#!/bin/sh
# Writes the .NET variables into /etc/environment (read by PAM for every
# SSH session, also the one VS Code uses). The block between the markers
# belongs to clawbook-dotnet; it is rewritten on every configure and
# removed by postrm.
set -e
BEGIN='# >>> clawbook-dotnet >>>'
END='# <<< clawbook-dotnet <<<'
case "$1" in
  configure)
    touch /etc/environment
    sed -i "\|^$BEGIN\$|,\|^$END\$|d" /etc/environment
    {
      echo "$BEGIN"
      echo "DOTNET_ROOT=/usr/lib/dotnet"
      echo "DOTNET_CLI_TELEMETRY_OPTOUT=1"
      echo "DOTNET_NOLOGO=1"
      echo "DOTNET_SKIP_WORKLOAD_INTEGRITY_CHECK=1"
      echo "$END"
    } >> /etc/environment
    ;;
esac
exit 0
